generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
// Inventory & Purchase additions
// =============================

// Business scope kategori untuk BrandProfile
enum BusinessScope {
  CREATIVE
  PROCUREMENT
  SOUVENIR
}

enum StockMutationType {
  IN
  OUT
  ADJUST
}

enum QuotationStatus {
  Draft
  Sent
  Viewed
  Confirmed
  Accepted
  Approved
  Rejected
  Expired
  Converted
  Canceled
}

enum SalesOrderStatus {
  Draft
  Confirmed
  Processing
  Shipping
  Delivered
  Completed
  Canceled
}

enum InvoiceStatus {
  Draft
  Issued
  Paid
  Void
  Canceled
}

enum PaymentStatus {
  UNPAID
  DP
  PARTIAL
  PAID
  VOID
}

enum PurchaseStatus {
  Draft
  Processing
  PendingApproval
  Ordered
  WaitingSupplier
  SupplierApproved
  DPPaid
  Production
  QCProcess
  ReadyShipment
  Shipped
  Received
  Delivered
  Completed
  Canceled
}

model Customer {
  id          Int          @id @default(autoincrement())
  pic         String
  company     String
  address     String
  phone       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean      @default(false)
  email       String?
  brandProfileId Int?
  invoices    Invoice[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  brand       BrandProfile? @relation(fields: [brandProfileId], references: [id])

  @@index([brandProfileId])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("customer")
}

model Supplier {
  id              Int              @id @default(autoincrement())
  name            String
  pic             String?
  email           String?
  phone           String?
  address         String?
  brandProfileId  Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)
  
  brand           BrandProfile?    @relation(fields: [brandProfileId], references: [id])
  purchaseOrders  PurchaseOrder[]
  purchases       PurchaseDirect[]
  salesOrderItems SalesOrderItem[]
  
  @@index([brandProfileId])
  @@index([isDeleted])
  @@map("supplier")
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique(map: "Quotation_quotationNumber_key")
  date            DateTime
  validUntil      DateTime
  projectDesc     String
  notes           String?
  customerId      Int
  brandProfileId  Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean         @default(false)
  projectFileUrl  String?
  status          QuotationStatus @default(Draft)
  totalAmount     Float           @default(0)
  shareUrl        String?
  sentVia         String?
  
  // Negotiation tracking
  isNegotiated    Boolean         @default(false)
  originalAmount  Float?
  negotiatedAmount Float?
  marginChange    Float?
  negotiationNotes String?
  viewedAt        DateTime?
  
  // Client documents on approval
  clientPoUrl     String?
  clientSoUrl     String?
  clientOtherFiles Json?          @default("[]")
  
  customer        Customer        @relation(fields: [customerId], references: [id])
  brand           BrandProfile?   @relation(fields: [brandProfileId], references: [id])
  items           QuotationItem[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  revisions       QuotationRevision[]

  @@index([customerId])
  @@index([brandProfileId])
  @@index([date])
  @@index([status])
  @@index([isDeleted])
  @@map("quotation")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  product     String
  description String
  quantity    Int
  unit        String
  price       Float
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subtotal    Float     @default(0)
  
  // Internal cost fields (Hidden from client)
  supplierCost        Float?    @default(0)
  titipanCostAdjustment Float?  @default(0)
  hiddenMargin        Float?    @default(0)
  taxAdjustment       Float?    @default(0)
  
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
  @@map("quotationitem")
}

model SalesOrder {
  id            Int              @id @default(autoincrement())
  orderNumber   String           @unique(map: "SalesOrder_orderNumber_key")
  date          DateTime
  status        SalesOrderStatus @default(Draft)
  notes         String?
  quotationId   Int?
  customerId    Int
  brandProfileId Int?
  totalAmount   Float            @default(0)
  paidAmount    Float            @default(0)
  paymentStatus PaymentStatus    @default(UNPAID)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean          @default(false)
  extraDiscount Float            @default(0)
  lineDiscount  Float            @default(0)
  subtotal      Float            @default(0)
  taxAmount     Float            @default(0)
  taxMode       String           @default("none")
  customer      Customer         @relation(fields: [customerId], references: [id])
  quotation     Quotation?       @relation(fields: [quotationId], references: [id])
  brand         BrandProfile?    @relation(fields: [brandProfileId], references: [id])
  items         SalesOrderItem[]
  paymentsIn    PaymentIn[]
  // Back-relation to purchases
  purchases     PurchaseDirect[]
  purchaseOrders PurchaseOrder[]
  deliveryOrders DeliveryOrder[]
  invoices       Invoice[]
  shareUrl      String?
  
  // Build by Order Logic
  isNonInventory Boolean @default(false)

  @@index([customerId])
  @@index([quotationId])
  @@index([brandProfileId])
  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([isDeleted])
  @@map("salesorder")
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  product      String
  description  String
  quantity     Int
  unit         String
  price        Float
  imageUrl     String?
  subtotal     Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  discount     Float      @default(0)
  
  // Internal cost fields
  supplierCost        Float?    @default(0)
  titipanCostAdjustment Float?  @default(0)
  hiddenMargin        Float?    @default(0)
  taxAdjustment       Float?    @default(0)
  supplierId          Int?
  
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  supplier     Supplier?  @relation(fields: [supplierId], references: [id])

  @@index([salesOrderId])
  @@index([supplierId])
  @@map("salesorderitem")
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique
  issueDate          DateTime
  dueDate            DateTime
  status             InvoiceStatus @default(Draft)
  notes              String?
  terms              String?
  customerId         Int
  quotationId        Int?
  salesOrderId       Int?
  brandProfileId     Int?
  subtotal           Float         @default(0)
  lineDiscount       Float         @default(0)
  extraDiscountType  String        @default("amount")
  extraDiscountValue Float         @default(0)
  shippingCost       Float         @default(0)
  taxMode            String        @default("none")
  taxAmount          Float         @default(0)
  downPayment        Float         @default(0)
  total              Float         @default(0)
  paidAmount         Float         @default(0)
  paymentStatus      PaymentStatus @default(UNPAID)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  isDeleted          Boolean       @default(false)
  shareUrl           String?
  customer           Customer      @relation(fields: [customerId], references: [id])
  quotation          Quotation?    @relation(fields: [quotationId], references: [id])
  salesOrder         SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  brand              BrandProfile? @relation(fields: [brandProfileId], references: [id])
  items              InvoiceItem[]
  paymentsIn         PaymentIn[]

  @@index([customerId])
  @@index([quotationId])
  @@index([brandProfileId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([isDeleted])
  @@map("invoice")
}

model InvoiceItem {
  id           Int      @id @default(autoincrement())
  invoiceId    Int
  name         String
  description  String?
  qty          Int
  unit         String   @default("pcs")
  price        Float
  discount     Float    @default(0)
  discountType String   @default("percent")
  subtotal     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoiceitem")
}

model ProductCategory {
  id          Int               @id @default(autoincrement())
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  code        String            @unique
  description String?
  parentId    Int?
  brandProfileId Int?
  products    Product[]
  parent      ProductCategory?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryToParent")
  brand       BrandProfile?     @relation(fields: [brandProfileId], references: [id])
  deletedAt   DateTime?
  isDeleted   Boolean           @default(false)

  @@index([parentId])
  @@index([brandProfileId])
  @@index([isDeleted])
  @@map("productcategory")
}

model Product {
  id          Int              @id @default(autoincrement())
  sku         String           @unique
  name        String
  description String?
  categoryId  Int?
  brandProfileId Int?
  unit        String           @default("pcs")
  buyPrice    Float            @default(0)
  sellPrice   Float            @default(0)
  trackStock  Boolean          @default(false)
  qty         Int              @default(0)
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean          @default(false)
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  brand       BrandProfile?    @relation(fields: [brandProfileId], references: [id])
  stockMutations StockMutation[]
  purchaseItems  PurchaseDirectItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([categoryId])
  @@index([brandProfileId])
  @@index([isDeleted])
  @@index([qty])
  @@map("product")
}

model BrandProfile {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  overview         String?
  address          String?
  phone            String?
  email            String?
  website          String?
  footerText       String?
  paymentInfo      String?  @db.Text
  termsConditions  String?  @db.Text
  showBrandName    Boolean  @default(true)
  showBrandDescription Boolean @default(true)
  showBrandEmail   Boolean  @default(true)
  showBrandWebsite Boolean  @default(true)
  showBrandAddress Boolean  @default(true)
  logoUrl          String?  @db.Text
  templateOptionId String?
  templateDefaults Json     @default("{}")
  numberFormats    Json     @default("{}")
  modules          Json     @default("{}")
  // Kategori utama brand yang menentukan modul aktif
  businessScope    BusinessScope @default(PROCUREMENT)
  primaryColor     String?  @default("#0EA5E9")
  secondaryColor   String?  @default("#ECFEFF")
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  // Back-relations
  customers       Customer[]
  quotations      Quotation[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  products        Product[]
  categories      ProductCategory[]
  purchases       PurchaseDirect[]
  stockMutations  StockMutation[]
  payments        Payment[]
  receipts        Receipt[]
  expenses        Expense[]
  suppliers       Supplier[]
  notifications   Notification[]
  // New relations for additional finance models
  purchaseInvoices PurchaseInvoice[]
  paymentsIn      PaymentIn[]
  paymentsOut     PaymentOut[]
  // Purchase Order relations
  purchaseOrders  PurchaseOrder[]
  deliveryOrders  DeliveryOrder[]
  // Opposite relations for User default brand & brand scopes
  defaultUsers    User[]           @relation("UserDefaultBrand")
  userBrandScopes UserBrandScope[]
  signatureProfiles SignatureProfile[]
  // Back-relation for ShortLink.brand
  shortLinks      ShortLink[]

  @@map("brand_profile")
}

model Template {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  type         String   // invoice, quotation, sales_order, delivery_note, universal
  category     String   @default("custom") // custom, default
  fileUrl      String
  thumbnailUrl String?
  placeholders Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("template")
}

// =============================
// Purchase Direct Models
// =============================

model PurchaseDirect {
  id              Int       @id @default(autoincrement())
  purchaseNumber  String    @unique
  date            DateTime
  supplierId      Int?
  supplierName    String?
  marketplaceOrderId String?
  notes           String?
  attachments     Json      @default("[]")
  status          PurchaseStatus @default(Draft) // Draft | Received | Canceled
  receivedAt      DateTime?
  // Biaya dan total
  subtotal        Float     @default(0)
  shippingCost    Float     @default(0)
  fee             Float     @default(0)
  tax             Float     @default(0)
  total           Float     @default(0)
  paidAmount      Float     @default(0)
  paymentStatus   PaymentStatus @default(UNPAID)
  proofUrl        String?
  salesOrderId    Int?
  brandProfileId  Int?
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean   @default(false)

  items           PurchaseDirectItem[]
  brand           BrandProfile? @relation(fields: [brandProfileId], references: [id])
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  createdBy       User?         @relation(fields: [createdByUserId], references: [id])
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  purchaseInvoices PurchaseInvoice[]

  @@index([brandProfileId])
  @@index([salesOrderId])
  @@index([createdByUserId])
  @@index([supplierId])
  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([isDeleted])
  @@map("purchasedirect")
}

model PurchaseDirectItem {
  id               Int             @id @default(autoincrement())
  purchaseDirectId Int
  productId        Int?
  name             String
  description      String?
  qty              Int
  unit             String          @default("pcs")
  unitCost         Float?          @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  purchase         PurchaseDirect  @relation(fields: [purchaseDirectId], references: [id])
  product          Product?        @relation(fields: [productId], references: [id])

  @@index([purchaseDirectId])
  @@index([productId])
  @@map("purchasedirectitem")
}

// =============================
// Purchase Invoice Models
// =============================

enum PurchaseInvoiceStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
  Canceled
}

model PurchaseInvoice {
  id               Int                     @id @default(autoincrement())
  invoiceNumber    String
  date             DateTime
  dueDate          DateTime?
  supplierName     String
  notes            String?
  subtotal         Float                    @default(0)
  shippingCost     Float                    @default(0)
  tax              Float                    @default(0)
  total            Float                    @default(0)
  paidAmount       Float                    @default(0)
  status           PurchaseInvoiceStatus    @default(Draft)
  brandProfileId   Int?
  purchaseDirectId Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  brand            BrandProfile?            @relation(fields: [brandProfileId], references: [id])
  purchase         PurchaseDirect?          @relation(fields: [purchaseDirectId], references: [id])
  purchaseOrder    PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId  Int?
  items            PurchaseInvoiceItem[]
  payments         PaymentOut[]
  deletedAt        DateTime?
  isDeleted        Boolean                  @default(false)

  @@index([brandProfileId])
  @@index([purchaseDirectId])
  @@index([date])
  @@index([status])
  @@index([isDeleted])
  @@unique([brandProfileId, invoiceNumber])
  @@map("purchaseinvoice")
}

model PurchaseInvoiceItem {
  id                 Int               @id @default(autoincrement())
  purchaseInvoiceId  Int
  productId          Int?
  name               String
  description        String?
  qty                Int
  unit               String            @default("pcs")
  unitCost           Float             @default(0)
  subtotal           Float             @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  invoice            PurchaseInvoice   @relation(fields: [purchaseInvoiceId], references: [id])
  product            Product?          @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
  @@map("purchaseinvoiceitem")
}

model StockMutation {
  id              Int               @id @default(autoincrement())
  productId       Int
  qty             Int
  type            StockMutationType
  refTable        String?
  refId           Int?
  note            String?
  brandProfileId  Int?
  createdByUserId Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  product         Product           @relation(fields: [productId], references: [id])
  brand           BrandProfile?     @relation(fields: [brandProfileId], references: [id])
  createdBy       User?             @relation(fields: [createdByUserId], references: [id])
  deletedAt       DateTime?
  isDeleted       Boolean           @default(false)

  @@index([productId])
  @@index([brandProfileId])
  @@index([createdByUserId])
  @@index([isDeleted])
  @@map("stockmutation")
}

// =============================
// Finance Models
// =============================

enum PaymentType {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BCA
  BRI
  OTHER
}

enum PaymentRefType {
  SALES_ORDER
  INVOICE
  PURCHASE
  EXPENSE
}

model Payment {
  id             Int            @id @default(autoincrement())
  brandProfileId Int?
  type           PaymentType
  method         PaymentMethod
  amount         Float          @default(0)
  paidAt         DateTime
  refType        PaymentRefType
  refId          Int
  notes          String?
  createdById    Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brand          BrandProfile?  @relation(fields: [brandProfileId], references: [id])
  createdBy      User?          @relation(fields: [createdById], references: [id])
  receipt        Receipt?
  expense        Expense?
  deletedAt      DateTime?
  isDeleted      Boolean        @default(false)

  @@index([brandProfileId])
  @@index([refType, refId])
  @@index([createdById])
  @@index([isDeleted])
  @@map("payment")
}

model Receipt {
  id             Int            @id @default(autoincrement())
  brandProfileId Int?
  paymentId      Int            @unique
  receiptNumber  String
  pdfUrl         String?
  shareUrl       String?
  createdAt      DateTime       @default(now())

  brand          BrandProfile?  @relation(fields: [brandProfileId], references: [id])
  payment        Payment        @relation(fields: [paymentId], references: [id])
  deletedAt      DateTime?
  isDeleted      Boolean        @default(false)

  @@index([brandProfileId])
  @@index([isDeleted])
  @@unique([brandProfileId, receiptNumber])
  @@map("receipt")
}

// New separated payment models
enum PaymentInStatus {
  Draft
  Posted
  Voided
}

enum PaymentOutStatus {
  Draft
  Posted
  Voided
}

model PaymentIn {
  id             Int             @id @default(autoincrement())
  brandProfileId Int?
  method         PaymentMethod
  amount         Float           @default(0)
  paidAt         DateTime
  status         PaymentInStatus @default(Posted)
  isDP           Boolean         @default(false)
  notes          String?
  createdById    Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // References (one of these can be set)
  invoiceId      Int?
  salesOrderId   Int?

  brand          BrandProfile?   @relation(fields: [brandProfileId], references: [id])
  createdBy      User?           @relation(fields: [createdById], references: [id])
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  salesOrder     SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  deletedAt      DateTime?
  isDeleted      Boolean         @default(false)

  @@index([brandProfileId])
  @@index([invoiceId])
  @@index([salesOrderId])
  @@index([createdById])
  @@index([paidAt])
  @@index([status])
  @@index([isDeleted])
  @@map("paymentin")
}

model PaymentOut {
  id                 Int              @id @default(autoincrement())
  brandProfileId     Int?
  method             PaymentMethod
  amount             Float            @default(0)
  paidAt             DateTime
  status             PaymentOutStatus @default(Posted)
  isDP               Boolean          @default(false)
  notes              String?
  createdById        Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // References (one of these can be set)
  purchaseInvoiceId  Int?
  // Expense relation is defined on Expense via paymentOutId

  brand              BrandProfile?    @relation(fields: [brandProfileId], references: [id])
  createdBy          User?            @relation(fields: [createdById], references: [id])
  purchaseInvoice    PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  // Back relation to Expense (owned by Expense.paymentOutId)
  expense            Expense?
  deletedAt          DateTime?
  isDeleted          Boolean          @default(false)

  @@index([brandProfileId])
  @@index([purchaseInvoiceId])
  @@index([createdById])
  @@index([paidAt])
  @@index([status])
  @@index([isDeleted])
  @@map("paymentout")
}

model Expense {
  id             Int            @id @default(autoincrement())
  brandProfileId Int?
  category       String
  amount         Float          @default(0)
  payee          String?
  attachmentUrl  String?
  paidAt         DateTime
  notes          String?
  paymentId      Int?           @unique
  paymentOutId   Int?           @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brand          BrandProfile?  @relation(fields: [brandProfileId], references: [id])
  payment        Payment?       @relation(fields: [paymentId], references: [id])
  paymentOut     PaymentOut?    @relation(fields: [paymentOutId], references: [id])
  deletedAt      DateTime?
  isDeleted      Boolean        @default(false)

  @@index([brandProfileId])
  @@index([paymentId])
  @@index([paymentOutId])
  @@index([paidAt])
  @@index([isDeleted])
  @@map("expense")
}

// =============================
// Auth & RBAC Models
// =============================

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  username     String?       @unique
  name         String?
  firstName    String?
  lastName     String?
  phone        String?
  bio          String?
  address      String?
  city         String?
  country      String?
  postalCode   String?
  taxId        String?
  company      String?
  website      String?
  avatar       String?
  facebook     String?
  twitter      String?
  linkedin     String?
  instagram    String?
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  defaultBrandProfileId Int?

  defaultBrand BrandProfile? @relation("UserDefaultBrand", fields: [defaultBrandProfileId], references: [id])

  roles        UserRole[]
  brandScopes  UserBrandScope[]
  activityLogs ActivityLog[]
  loginLogs    LoginLog[]
  notifications Notification[]
  payments     Payment[]
  // Back-relations for createdBy on purchases and stock mutations
  createdPurchases PurchaseDirect[]
  createdStockMutations StockMutation[]
  // Back-relations for createdBy on payments
  createdPaymentsIn PaymentIn[]
  createdPaymentsOut PaymentOut[]

  @@index([defaultBrandProfileId])
  @@map("user")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  permissions Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       UserRole[]

  @@map("role")
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// Relasi akses brand per user
model UserBrandScope {
  id              Int @id @default(autoincrement())
  userId          Int
  brandProfileId  Int
  isBrandAdmin    Boolean @default(false)
  createdAt       DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id])
  brand  BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@unique([userId, brandProfileId])
  @@index([brandProfileId])
  @@index([userId])
  @@map("user_brand_scope")
}

// Tambahkan model SignatureProfile sebelum model ActivityLog
model SignatureProfile {
  id            Int          @id @default(autoincrement())
  name          String
  title         String?
  imageUrl      String
  brandProfileId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean      @default(false)
  brand         BrandProfile? @relation(fields: [brandProfileId], references: [id])

  @@index([brandProfileId])
  @@map("signatureprofile")
}

model ActivityLog {
  id        Int       @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  Int?
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("activity_log")
}

model LoginLog {
  id        Int       @id @default(autoincrement())
  userId    Int?
  action    String    // LOGIN | LOGOUT
  success   Boolean   @default(true)
  ip        String?
  userAgent String?
  message   String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("login_log")
}

model Notification {
  id             Int       @id @default(autoincrement())
  title          String
  message        String
  type           NotificationType
  userId         Int?
  brandProfileId Int?
  roleTarget     NotificationRoleTarget?
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  targetUrl      String?   @db.VarChar(255)

  user           User?         @relation(fields: [userId], references: [id])
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id])

  @@index([userId])
  @@index([brandProfileId])
  @@map("notification")
}

enum NotificationType {
  info
  success
  warning
  error
}

enum NotificationRoleTarget {
  OWNER
  ADMIN
  STAFF
  ALL
}

// =============================
// ShortLink Model
// =============================

model ShortLink {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  targetUrl       String
  brandProfileId  Int?
  entity          String?
  entityId        Int?
  visitCount      Int           @default(0)
  lastAccessAt    DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?

  brand           BrandProfile? @relation(fields: [brandProfileId], references: [id])

  @@index([brandProfileId])
  @@index([entity, entityId])
  @@map("shortlink")
}

// =============================
// Purchase Order Models
// =============================

model PurchaseOrder {
  id               Int                     @id @default(autoincrement())
  orderNumber      String                  @unique
  date             DateTime
  status           PurchaseStatus          @default(Draft)
  notes            String?
  attachments      Json                    @default("[]")
  supplierId       Int?
  supplierName     String?
  brandProfileId   Int?
  subtotal         Float                   @default(0)
  lineDiscount     Float                   @default(0)
  extraDiscount    Float                   @default(0)
  taxMode          String                  @default("none")
  taxAmount        Float                   @default(0)
  totalAmount      Float                   @default(0)
  salesOrderId     Int?
  createdByUserId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean                 @default(false)

  brand            BrandProfile?           @relation(fields: [brandProfileId], references: [id])
  salesOrder       SalesOrder?             @relation(fields: [salesOrderId], references: [id])
  supplier         Supplier?               @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  purchaseInvoices PurchaseInvoice[]

  @@index([brandProfileId])
  @@index([supplierId])
  @@index([date])
  @@index([status])
  @@index([isDeleted])
  @@map("purchaseorder")
}

model PurchaseOrderItem {
  id              Int             @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int?
  product         String
  description     String?
  quantity        Int
  unit            String          @default("pcs")
  price           Float           @default(0)
  discount        Float           @default(0)
  subtotal        Float           @default(0)
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  productDetail   Product?        @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchaseorderitem")
}

model QuotationRevision {
  id              Int       @id @default(autoincrement())
  quotationId     Int
  revisedAt       DateTime  @default(now())
  amount          Float
  margin          Float?
  notes           String?
  metadata        Json      @default("{}")
  
  quotation       Quotation @relation(fields: [quotationId], references: [id])
  
  @@index([quotationId])
  @@map("quotationrevision")
}

model DeliveryOrder {
  id              Int       @id @default(autoincrement())
  doNumber        String    @unique
  date            DateTime
  status          String    @default("Draft") // Draft, Shipped, Delivered
  salesOrderId    Int?
  brandProfileId  Int?
  
  // Expedition info
  expeditionName  String?
  driverName      String?
  vehicleNumber   String?
  receiverPIC     String?
  proofOfDeliveryUrl String?
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean   @default(false)
  
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  brand           BrandProfile? @relation(fields: [brandProfileId], references: [id])
  items           DeliveryOrderItem[]
  
  @@index([salesOrderId])
  @@index([brandProfileId])
  @@map("deliveryorder")
}

model DeliveryOrderItem {
  id              Int       @id @default(autoincrement())
  deliveryOrderId Int
  product         String
  description     String?
  quantity        Int
  unit            String    @default("pcs")
  
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  
  @@index([deliveryOrderId])
  @@map("deliveryorderitem")
}
