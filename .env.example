NEXT_PUBLIC_APP_NAME="Bakung Dashboard"

# Base URL untuk shortlink (set di Production agar konsisten)
# Contoh: https://bakung-dashboard.vercel.app
APP_BASE_URL="http://localhost:3000"

# TiDB Cloud connection string format
# Replace placeholders accordingly
DATABASE_URL="mysql://<cluster-id>.root:<password>@<gateway-host>:4000/<database>?sslaccept=strict"

# Optional seed owner user
# SEED_OWNER_EMAIL="owner@example.com"
# SEED_OWNER_PASSWORD="owner123"
