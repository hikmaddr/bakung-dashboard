NEXT_PUBLIC_APP_NAME="Bakung Dashboard"

# Base URL (set di Production, mis. https://bakung-dashboard.vercel.app)
APP_BASE_URL="http://localhost:3000"

# Neon PostgreSQL (pakai pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="ganti-dengan-secret-acak-yang-kuat"

# Vercel Blob (upload file production)
BLOB_READ_WRITE_TOKEN=""

# Google integration (opsional)
GOOGLE_SERVICE_ACCOUNT_KEY=""

# Seed owner user (opsional)
# SEED_OWNER_EMAIL="owner@example.com"
# SEED_OWNER_PASSWORD="owner123"
